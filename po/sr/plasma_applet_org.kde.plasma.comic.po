# >> @title
#: qml/ErrorPlaceholder.qml:18
#, kde-format
msgctxt "@info placeholdermessage if comic loading failed"
msgid "Could not load comic"
msgstr "Не могу да учитам стрип"

#: qml/ErrorPlaceholder.qml:19
#, kde-format
msgctxt "@info placeholdermessage explanation"
msgid "Try again later, or choose a different comic"
msgstr "Покушајте поново касније или изаберите други стрип"

#: qml/ErrorPlaceholder.qml:27
#, kde-format
msgctxt "@info placeholdermessage title if offline"
msgid "Offline"
msgstr "Ван везе"

#: qml/ErrorPlaceholder.qml:28
#, kde-format
msgctxt "@info placeholdermessage connection"
msgid ""
"Reconnect to the internet to retry loading this image. You can still view "
"any images in the local archive."
msgstr ""
"Поново се повежите на интернет да бисте још једном покушали да учитате ову "
"слику. И даље можете гледати слике из локалне архиве."

#: qml/ErrorPlaceholder.qml:36
#, kde-format
msgctxt "@info placeholdermessage title if connection local/unknown"
msgid "Limited connectivity"
msgstr "Ограничена повезивост"

#: qml/ErrorPlaceholder.qml:37
#, kde-format
msgctxt "@info placeholdermessage explanation if connection local/unknown"
msgid ""
"The image may not be available on your current connection. You can still "
"view any images in the local archive."
msgstr ""
"Слика можда није доступна преко тренутне везе. И даље можете гледати слике "
"из локалне архиве."

#: qml/ErrorPlaceholder.qml:45
#, kde-format
msgctxt "@info placeholdermessage title if today not available"
msgid "Not available"
msgstr "Није доступно"

#: qml/ErrorPlaceholder.qml:46
#, kde-format
msgctxt "@info placeholdermessage explanation if today not available"
msgid ""
"Today's image is not yet available or cannot be read. Try a different date."
msgstr ""
"Данашња слика још није доступна или не може да се прочита. Покушајте са "
"другим датумом."

#: qml/ErrorPlaceholder.qml:54
#, kde-format
msgctxt "@info placeholdermessage title if date not available"
msgid "Not available"
msgstr "Није доступно"

#: qml/ErrorPlaceholder.qml:55
#, kde-format
msgctxt "@info placeholdermessage explanation if date not available"
msgid ""
"The image for this day is not available or cannot be read. Try a different "
"date."
msgstr ""
"Слика за овај дан није доступна или не може да се прочита. Покушајте са "
"другим датумом."

