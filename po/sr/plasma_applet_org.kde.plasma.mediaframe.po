#: qml/config.qml:13
#, kde-format
msgctxt "@title"
msgid "Media"
msgstr "Медији"

#: qml/config.qml:18
#, kde-format
msgctxt "@title"
msgid "Behavior"
msgstr "Понашање"

#: qml/ConfigBehavior.qml:33
#, kde-format
msgctxt "@label:group form label for spinboxes"
msgid "Change picture every:"
msgstr "Мењај слику сваких:"

#: qml/ConfigBehavior.qml:52
#, kde-format
msgctxt "@item:valuesuffix"
msgid "Hours"
msgstr "сати"

#: qml/ConfigBehavior.qml:66
#, kde-format
msgctxt "@item:valuesuffix"
msgid "Minutes"
msgstr "минута"

#: qml/ConfigBehavior.qml:80
#, kde-format
msgctxt "@item:valuesuffix"
msgid "Seconds"
msgstr "секунди"

#: qml/ConfigBehavior.qml:88
#, kde-format
msgctxt "@option:check"
msgid "Randomize order"
msgstr "Насумичан редослед"

# skip-rule: t-cursor
#: qml/ConfigBehavior.qml:95
#, fuzzy, kde-format
#| msgctxt "@option:check"
#| msgid "Pause slideshow when cursor is over image"
msgctxt "@option:check"
msgid "Pause slideshow when hovered"
msgstr "Паузирај слајдшоу када је показивач над сликом"

#: qml/ConfigBehavior.qml:101
#, kde-format
msgctxt "@label:listbox"
msgid "Image fill mode:"
msgstr "Режим попуне слике:"

# >> @item:inlistbox Fill mode
#: qml/ConfigBehavior.qml:109
#, kde-format
msgctxt "@item:inlistbox"
msgid "Stretch"
msgstr "развучено"

# >> @text:tooltip
#: qml/ConfigBehavior.qml:110
#, kde-format
msgctxt "@info"
msgid "The image is scaled to fit the frame"
msgstr "Слика се скалира да стане у оквир."

# >> @item:inlistbox Fill mode
#: qml/ConfigBehavior.qml:114
#, kde-format
msgctxt "@item:inlistbox"
msgid "Preserve aspect fit"
msgstr "уклапање по размери"

# >> @text:tooltip
#: qml/ConfigBehavior.qml:115
#, kde-format
msgctxt "@info"
msgid "The image is scaled uniformly to fit without cropping"
msgstr "Слика се скалира равномерно да стане без опсецања."

# >> @item:inlistbox Fill mode
#: qml/ConfigBehavior.qml:119
#, kde-format
msgctxt "@item:inlistbox"
msgid "Preserve aspect crop"
msgstr "опсецање по размери"

# >> @text:tooltip
#: qml/ConfigBehavior.qml:120
#, kde-format
msgctxt "@info"
msgid "The image is scaled uniformly to fill, cropping if necessary"
msgstr "Слика се скалира равномерно да попуни све, ако треба уз опсецање."

# >> @item:inlistbox Fill mode
#: qml/ConfigBehavior.qml:124
#, kde-format
msgctxt "@item:inlistbox"
msgid "Tile"
msgstr "поплочано"

# >> @text:tooltip
#: qml/ConfigBehavior.qml:125
#, kde-format
msgctxt "@info"
msgid "The image is duplicated horizontally and vertically"
msgstr "Слика се умножава водоравно и усправно."

# >> @item:inlistbox Fill mode
#: qml/ConfigBehavior.qml:129
#, kde-format
msgctxt "@item:inlistbox"
msgid "Tile vertically"
msgstr "поплочано усправно"

# >> @text:tooltip
#: qml/ConfigBehavior.qml:130
#, kde-format
msgctxt "@info"
msgid "The image is stretched horizontally and tiled vertically"
msgstr "Слика се развлачи водоравно а поплочава усправно."

# >> @item:inlistbox Fill mode
#: qml/ConfigBehavior.qml:134
#, kde-format
msgctxt "@item:inlistbox"
msgid "Tile horizontally"
msgstr "поплочано водоравно"

# >> @text:tooltip
#: qml/ConfigBehavior.qml:135
#, kde-format
msgctxt "@info"
msgid "The image is stretched vertically and tiled horizontally"
msgstr "Слика се развлачи усправно а поплочава водоравно."

# >> @item:inlistbox Fill mode
#: qml/ConfigBehavior.qml:139
#, kde-format
msgctxt "@item:inlistbox"
msgid "Pad"
msgstr "попуњене ивице"

# >> @text:tooltip
#: qml/ConfigBehavior.qml:140
#, kde-format
msgctxt "@info"
msgid "The image is not transformed"
msgstr "Слика се никако не мења."

#: qml/ConfigBehavior.qml:150
#, kde-format
msgctxt "@option:check prefix completes … Open in external application"
msgid "When clicking image:"
msgstr ""

#: qml/ConfigBehavior.qml:153
#, fuzzy, kde-format
#| msgctxt "@option:check"
#| msgid "Click on image to open in external application"
msgctxt "@option:check"
msgid "Open in external application"
msgstr "Клик на слику отвара је у спољашњем програму"

#: qml/ConfigMedia.qml:26
#, kde-format
msgctxt "@action:button"
msgid "Add Folder…"
msgstr "Додај фасциклу…"

#: qml/ConfigMedia.qml:31
#, kde-format
msgctxt "@action:button"
msgid "Add Files…"
msgstr "Додај фајлове…"

#: qml/ConfigMedia.qml:80
#, kde-format
msgctxt "@action:button tooltip on icon-only button"
msgid "Remove path"
msgstr "Уклони путању"

#: qml/ConfigMedia.qml:93
#, kde-format
msgctxt "@info placeholdermessage if no paths set"
msgid "No media configured"
msgstr "Нема подешених медија"

#: qml/ConfigMedia.qml:94
#, kde-format
msgctxt "@info placeholdermessage explanation"
msgid "Add files or folders to display them in the widget."
msgstr "Додајте фајлове или фасцикле да бисте их приказали у виџету."

# >> @title:window
#: qml/ConfigMedia.qml:100
#, kde-format
msgctxt "@title:window"
msgid "Choose Files"
msgstr "Избор фајлова"

# >> @title:window
#: qml/ConfigMedia.qml:120
#, kde-format
msgctxt "@title:window"
msgid "Choose a Folder"
msgstr "Избор фасцикле"

#: qml/main.qml:162
#, kde-format
msgctxt "@action:button icon-only"
msgid "Show previous image"
msgstr "Прикажи претходну слику"

#: qml/main.qml:173
#, kde-format
msgctxt "@action:button icon-only"
msgid "Show next image"
msgstr "Прикажи следећу слику"

#: qml/main.qml:183
#, kde-format
msgctxt "@action:button icon-only"
msgid "Open in default image viewer"
msgstr "Отвори у подразумеваном приказивачу слика"

#: qml/main.qml:355
#, kde-format
msgctxt "@info placeholdermessage if no media loaded"
msgid "No media selected"
msgstr "Нема изабраних медија"

#: qml/main.qml:359 qml/main.qml:369
#, kde-format
msgctxt "@action:button opens settings dialog"
msgid "Choose media…"
msgstr "Изабери медије…"

#~ msgctxt "@label:checkbox"
#~ msgid "General:"
#~ msgstr "Опште:"
