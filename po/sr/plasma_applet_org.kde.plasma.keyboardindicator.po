#: config.qml:13
#, kde-format
msgctxt "@title"
msgid "Keys"
msgstr "Тастери"

#: configAppearance.qml:37
#, kde-format
msgctxt ""
"@label show keyboard indicator when Caps Lock or Num Lock is activated"
msgid "Show when activated:"
msgstr "Прикажи кад је активиран:"

#: configAppearance.qml:41
#, kde-format
msgctxt "@option:check"
msgid "Caps Lock"
msgstr "CapsLock"

#: configAppearance.qml:49
#, kde-format
msgctxt "@option:check"
msgid "Num Lock"
msgstr "NumLock"

#: main.qml:117
#, kde-format
msgctxt "@info:tooltip widget subtitle, Alt applies to next press"
msgid "Alt is latched"
msgstr "Тастер Alt је запет"

#: main.qml:119
#, kde-format
msgctxt "@info:tooltip widget subtitle, Alt applies until pressed again"
msgid "Alt is locked"
msgstr "Тастер Alt је закључан"

#: main.qml:123
#, kde-format
msgctxt "@info:tooltip widget subtitle, Shift applies to next press"
