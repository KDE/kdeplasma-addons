#: qml/config.qml:13
#, kde-format
msgctxt "@title"
msgid "Media"
msgstr "მედია"

#: qml/config.qml:18
#, kde-format
msgctxt "@title"
msgid "Behavior"
msgstr "ქცევა"

#: qml/ConfigBehavior.qml:36
#, kde-format
msgctxt "@label:group form label for spinboxes"
msgid "Change picture every:"
msgstr "სურათის შეცვლა ყოველ:"

#: qml/ConfigBehavior.qml:53
#, kde-format
msgctxt "@item:valuesuffix"
msgid "Hours"
msgstr "საათი"

#: qml/ConfigBehavior.qml:67
#, kde-format
msgctxt "@item:valuesuffix"
msgid "Minutes"
msgstr "წთ"

#: qml/ConfigBehavior.qml:81
#, kde-format
msgctxt "@item:valuesuffix"
msgid "Seconds"
msgstr "წამი"

#: qml/ConfigBehavior.qml:91
#, kde-format
msgctxt "@label:listbox"
msgid "Image fill mode:"
msgstr "გამოსახულების შევსების რეჟიმი:"

#: qml/ConfigBehavior.qml:97
#, kde-format
msgctxt "@item:inlistbox"
msgid "Stretch"
msgstr "გაწელვა"

#: qml/ConfigBehavior.qml:98
#, kde-format
msgctxt "@info"
msgid "The image is scaled to fit the frame"
msgstr "გამოსახულების ფანჯარაში ჩატევა"

#: qml/ConfigBehavior.qml:102
#, kde-format
msgctxt "@item:inlistbox"
msgid "Preserve aspect fit"
msgstr "პროპორციების შენარჩუნება"

#: qml/ConfigBehavior.qml:103
#, kde-format
msgctxt "@info"
msgid "The image is scaled uniformly to fit without cropping"
msgstr "გამოსახულება გაიწელება პროპორციების შენარჩუნებით, მოჭრის გარეშე"

#: qml/ConfigBehavior.qml:107
#, kde-format
msgctxt "@item:inlistbox"
msgid "Preserve aspect crop"
msgstr "მოჭრა პროპორციების შენარჩუნებით"

#: qml/ConfigBehavior.qml:108
#, kde-format
msgctxt "@info"
msgid "The image is scaled uniformly to fill, cropping if necessary"
msgstr "გამოსახულება გაიწელება პროპორციულად. მოიჭრება, თუ საჭიროა"

#: qml/ConfigBehavior.qml:112
#, kde-format
msgctxt "@item:inlistbox"
msgid "Tile"
msgstr "ფილა"

#: qml/ConfigBehavior.qml:113
#, kde-format
msgctxt "@info"
msgid "The image is duplicated horizontally and vertically"
msgstr "გამოსახულება დუბლირდება ჰორიზონტალურადაც და ვერტიკალურადაც"

#: qml/ConfigBehavior.qml:117
#, kde-format
msgctxt "@item:inlistbox"
msgid "Tile vertically"
msgstr "ვერტიკალური ფილა"

#: qml/ConfigBehavior.qml:118
#, kde-format
msgctxt "@info"
msgid "The image is stretched horizontally and tiled vertically"
msgstr "გამოსახულება გაიწელება ჰორიზონტალურად და დაიჭრება ვერტიკალურად"

#: qml/ConfigBehavior.qml:122
#, kde-format
msgctxt "@item:inlistbox"
msgid "Tile horizontally"
msgstr "ჰორიზონტალური ფილა"

#: qml/ConfigBehavior.qml:123
#, kde-format
msgctxt "@info"
msgid "The image is stretched vertically and tiled horizontally"
msgstr "გამოსახულება გაიწელება ვერტიკალურად და დაიჭრება ჰორიზონტალურად"

#: qml/ConfigBehavior.qml:127
#, kde-format
msgctxt "@item:inlistbox"
msgid "Pad"
msgstr "პედი"

#: qml/ConfigBehavior.qml:128
#, kde-format
msgctxt "@info"
msgid "The image is not transformed"
msgstr "გამოსახულება არ გარდაიქმნება"

#: qml/ConfigBehavior.qml:149
#, kde-format
msgctxt "@label:checkbox"
msgid "General:"
msgstr "ზოგადი:"

#: qml/ConfigBehavior.qml:150
#, kde-format
msgctxt "@option:check"
msgid "Randomize order"
msgstr "შემთხვევითი ფერი"

#: qml/ConfigBehavior.qml:155
#, kde-format
msgctxt "@option:check"
msgid "Pause slideshow when cursor is over image"
msgstr "სლაიდშოუს გაჩერება, როცა კურსორი გამოსახულებაზე მიუთითებს"

#: qml/ConfigBehavior.qml:160
#, kde-format
msgctxt "@option:check"
msgid "Click on image to open in external application"
msgstr "დააწკაპუნეთ გამოსახულებაზე მის გარე პროგრამაში გასახსნელად"

#: qml/ConfigMedia.qml:26
#, kde-format
msgctxt "@action:button"
msgid "Add Folder…"
msgstr "საქაღალდის დამატება…"

#: qml/ConfigMedia.qml:31
#, kde-format
msgctxt "@action:button"
msgid "Add Files…"
msgstr "ფაილების დამატება…"

#: qml/ConfigMedia.qml:80
#, kde-format
msgctxt "@action:button tooltip on icon-only button"
msgid "Remove path"
msgstr "ბილიკის წაშლა"

#: qml/ConfigMedia.qml:93
#, kde-format
msgctxt "@info placeholdermessage if no paths set"
msgid "No media configured"
msgstr "მორგებული მედიის გარეშე"

#: qml/ConfigMedia.qml:94
#, kde-format
msgctxt "@info placeholdermessage explanation"
msgid "Add files or folders to display them in the widget."
msgstr "დაამატეთ ფაილები და საქაღალდეები მათი ვიჯეტში საჩვენებლად."

#: qml/ConfigMedia.qml:100
#, kde-format
msgctxt "@title:window"
msgid "Choose Files"
msgstr "აირჩიეთ ფაილები"

#: qml/ConfigMedia.qml:120
#, kde-format
msgctxt "@title:window"
msgid "Choose a Folder"
msgstr "აირჩიეთ საქაღალდე"

#: qml/main.qml:366
#, kde-format
msgctxt "@info placeholdermessage if no media loaded"
msgid "No media selected"
msgstr "მედია არჩეული არაა"

#: qml/main.qml:370 qml/main.qml:380
#, kde-format
msgctxt "@action:button opens settings dialog"
msgid "Choose media…"
msgstr "აირჩიეთ მედია…"

