#, kde-format
msgctxt "@action:button"
msgid "Add Folder…"
msgstr "Afegeix una carpeta…"

#: qml/ConfigMedia.qml:31
#, kde-format
msgctxt "@action:button"
msgid "Add Files…"
msgstr "Afegeix fitxers…"

#: qml/ConfigMedia.qml:80
#, kde-format
