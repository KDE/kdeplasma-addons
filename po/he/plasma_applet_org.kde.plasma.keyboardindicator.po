#: config.qml:13
#, kde-format
msgctxt "@title"
msgid "Keys"
msgstr "מקשים"

#: configAppearance.qml:37
#, kde-format
msgctxt ""
"@label show keyboard indicator when Caps Lock or Num Lock is activated"
msgid "Show when activated:"
msgstr "להציג כשפעילים:"

#: configAppearance.qml:40
#, kde-format
msgctxt "@option:check"
msgid "Caps Lock"
msgstr "Caps Lock"

#: configAppearance.qml:47
#, kde-format
msgctxt "@option:check"
msgid "Num Lock"
msgstr "Num Lock"

#: main.qml:117
#, kde-format
msgctxt "@info:tooltip widget subtitle, Alt applies to next press"
msgid "Alt is latched"
msgstr "Alt מוחזק"

#: main.qml:119
#, kde-format
msgctxt "@info:tooltip widget subtitle, Alt applies until pressed again"
msgid "Alt is locked"
msgstr "Alt נעול"

#: main.qml:123
#, kde-format
msgctxt "@info:tooltip widget subtitle, Shift applies to next press"
msgid "Shift is latched"
msgstr "Shift מוחזק"

#: main.qml:125
#, kde-format
msgctxt "@info:tooltip widget subtitle, Shift applies until pressed again"
msgid "Shift is locked"
msgstr "Shift נעול"

#: main.qml:129
#, kde-format
msgctxt "@info:tooltip widget subtitle, Ctrl applies to next press"
msgid "Control is latched"
msgstr "Control מוחזק"

#: main.qml:131
#, kde-format
msgctxt "@info:tooltip widget subtitle, Ctrl applies until pressed again"
msgid "Control is locked"
msgstr "Control נעול"

#: main.qml:135
#, kde-format
msgctxt "@info:tooltip widget subtitle, Meta applies to next press"
