#: converterrunner.cpp:30
#, kde-format
msgid "Copy unit and number"
msgstr "Copiar unidad y número"

#: converterrunner.cpp:33
#, kde-format
msgid ""
"Converts the value of :q: when :q: is made up of value unit [>, to, as, in] "
"unit.You can use the Unit converter applet to find all available units."
msgstr ""
"Convierte el valor de :q: cuando :q: se compone de valor unidad [>, a, como, "
"en] unidad. Puede usar la miniaplicación de conversión de unidades para "
"encontrar todas las unidades disponibles."

#: converterrunner.cpp:44
#, fuzzy, kde-format
#| msgctxt ""
#| "list of words that can used as amount of 'unit1' [in|to|as] 'unit2'"
#| msgid "in;to;as"
msgctxt ""
"list of words that can be used as amount of 'unit1' [in|to|as] 'unit2' (e.g. "
"'km [in|to|as] miles'). Can be more (or less) than three words, if it makes "
"sense. Do not put spaces before or after the `;`!"
msgid "in;to;as"
msgstr "en;a;como"
