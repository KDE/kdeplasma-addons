#: qml/config.qml:13
#, kde-format
msgctxt "@title"
msgid "Media"
msgstr "Mediji"

#: qml/config.qml:18
#, kde-format
msgctxt "@title"
msgid "Behavior"
msgstr "Ponašanje"

#: qml/ConfigBehavior.qml:33
#, kde-format
msgctxt "@label:group form label for spinboxes"
msgid "Change picture every:"
msgstr "Mijenjaj sliku svakih:"

#: qml/ConfigBehavior.qml:52
#, kde-format
msgctxt "@item:valuesuffix"
msgid "Hours"
msgstr "sati"

#: qml/ConfigBehavior.qml:66
#, kde-format
msgctxt "@item:valuesuffix"
msgid "Minutes"
msgstr "minuta"

#: qml/ConfigBehavior.qml:80
#, kde-format
msgctxt "@item:valuesuffix"
msgid "Seconds"
msgstr "sekundi"

#: qml/ConfigBehavior.qml:88
#, kde-format
msgctxt "@option:check"
msgid "Randomize order"
msgstr "Nasumičan redoslijed"

# skip-rule: t-cursor
#: qml/ConfigBehavior.qml:95
#, kde-format
msgctxt "@option:check"
msgid "Pause slideshow when hovered"
msgstr "Pauziraj slajdšou pri lebdjenju"

#: qml/ConfigBehavior.qml:101
#, kde-format
msgctxt "@label:listbox"
msgid "Image fill mode:"
msgstr "Režim popune slike:"

# >> @item:inlistbox Fill mode
#: qml/ConfigBehavior.qml:109
#, kde-format
msgctxt "@item:inlistbox"
msgid "Stretch"
msgstr "razvučeno"

# >> @text:tooltip
#: qml/ConfigBehavior.qml:110
#, kde-format
msgctxt "@info"
msgid "The image is scaled to fit the frame"
msgstr "Slika se skalira da stane u okvir."

# >> @item:inlistbox Fill mode
#: qml/ConfigBehavior.qml:114
#, kde-format
msgctxt "@item:inlistbox"
msgid "Preserve aspect fit"
msgstr "uklapanje po razmjeri"

# >> @text:tooltip
#: qml/ConfigBehavior.qml:115
#, kde-format
msgctxt "@info"
msgid "The image is scaled uniformly to fit without cropping"
msgstr "Slika se skalira ravnomjerno da stane bez opsijecanja."

# >> @item:inlistbox Fill mode
#: qml/ConfigBehavior.qml:119
#, kde-format
msgctxt "@item:inlistbox"
msgid "Preserve aspect crop"
msgstr "opsijecanje po razmjeri"

# >> @text:tooltip
#: qml/ConfigBehavior.qml:120
#, kde-format
msgctxt "@info"
msgid "The image is scaled uniformly to fill, cropping if necessary"
msgstr "Slika se skalira ravnomjerno da popuni sve, ako treba uz opsijecanje."

# >> @item:inlistbox Fill mode
#: qml/ConfigBehavior.qml:124
#, kde-format
msgctxt "@item:inlistbox"
msgid "Tile"
msgstr "popločano"

# >> @text:tooltip
#: qml/ConfigBehavior.qml:125
#, kde-format
msgctxt "@info"
msgid "The image is duplicated horizontally and vertically"
msgstr "Slika se umnožava vodoravno i uspravno."

# >> @item:inlistbox Fill mode
#: qml/ConfigBehavior.qml:129
#, kde-format
msgctxt "@item:inlistbox"
msgid "Tile vertically"
msgstr "popločano uspravno"

# >> @text:tooltip
#: qml/ConfigBehavior.qml:130
#, kde-format
msgctxt "@info"
msgid "The image is stretched horizontally and tiled vertically"
msgstr "Slika se razvlači vodoravno a popločava uspravno."

# >> @item:inlistbox Fill mode
#: qml/ConfigBehavior.qml:134
#, kde-format
msgctxt "@item:inlistbox"
msgid "Tile horizontally"
msgstr "popločano vodoravno"

# >> @text:tooltip
#: qml/ConfigBehavior.qml:135
#, kde-format
msgctxt "@info"
msgid "The image is stretched vertically and tiled horizontally"
msgstr "Slika se razvlači uspravno a popločava vodoravno."

# >> @item:inlistbox Fill mode
#: qml/ConfigBehavior.qml:139
#, kde-format
msgctxt "@item:inlistbox"
msgid "Pad"
msgstr "popunjene ivice"

# >> @text:tooltip
#: qml/ConfigBehavior.qml:140
#, kde-format
msgctxt "@info"
msgid "The image is not transformed"
msgstr "Slika se nikako ne mijenja."

#: qml/ConfigBehavior.qml:150
#, kde-format
msgctxt "@option:check prefix completes … Open in external application"
msgid "When clicking image:"
msgstr "Pri kliku na sliku:"

#: qml/ConfigBehavior.qml:153
#, kde-format
msgctxt "@option:check"
msgid "Open in external application"
msgstr "Otvori u spoljašnjem programu"

#: qml/ConfigMedia.qml:26
#, kde-format
msgctxt "@action:button"
msgid "Add Folder…"
msgstr "Dodaj fasciklu…"

#: qml/ConfigMedia.qml:31
#, kde-format
msgctxt "@action:button"
msgid "Add Files…"
msgstr "Dodaj fajlove…"

#: qml/ConfigMedia.qml:80
#, kde-format
msgctxt "@action:button tooltip on icon-only button"
msgid "Remove path"
msgstr "Ukloni putanju"

#: qml/ConfigMedia.qml:93
#, kde-format
msgctxt "@info placeholdermessage if no paths set"
msgid "No media configured"
msgstr "Nema podešenih medija"

#: qml/ConfigMedia.qml:94
#, kde-format
msgctxt "@info placeholdermessage explanation"
msgid "Add files or folders to display them in the widget."
msgstr "Dodajte fajlove ili fascikle da biste ih prikazali u vidžetu."

# >> @title:window
#: qml/ConfigMedia.qml:100
#, kde-format
msgctxt "@title:window"
msgid "Choose Files"
msgstr "Izbor fajlova"

# >> @title:window
#: qml/ConfigMedia.qml:120
#, kde-format
msgctxt "@title:window"
msgid "Choose a Folder"
msgstr "Izbor fascikle"

#: qml/main.qml:162
#, kde-format
msgctxt "@action:button icon-only"
msgid "Show previous image"
msgstr "Prikaži prethodnu sliku"

#: qml/main.qml:173
#, kde-format
msgctxt "@action:button icon-only"
msgid "Show next image"
msgstr "Prikaži sljedeću sliku"

#: qml/main.qml:183
#, kde-format
msgctxt "@action:button icon-only"
msgid "Open in default image viewer"
msgstr "Otvori u podrazumijevanom prikazivaču slika"

#: qml/main.qml:355
#, kde-format
msgctxt "@info placeholdermessage if no media loaded"
msgid "No media selected"
msgstr "Nema izabranih medija"

#: qml/main.qml:359 qml/main.qml:369
#, kde-format
msgctxt "@action:button opens settings dialog"
msgid "Choose media…"
msgstr "Izaberi medije…"
