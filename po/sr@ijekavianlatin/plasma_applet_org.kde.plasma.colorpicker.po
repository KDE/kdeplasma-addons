msgstr "Srednji klik kopira kôd boje"

# >> @option:radio When pressing the keyboard shortcut:
#: qml/CompactRepresentation.qml:84
#, kde-format
msgctxt "@info:tooltip"
msgid "Pick color"
msgstr "Izaberi boju"

#: qml/CompactRepresentation.qml:91
#, kde-kuit-format
msgctxt "@info:usagetip"
msgid ""
"Drag a color code here to save it<nl/>Drag an image file here to get its "
"average color"
msgstr ""
"Prevucite ovamo kôd boje da ga sačuvate<nl/>Prevucite ovamo fajl slike da "
"dobijete njegovu prosječnu boju"

