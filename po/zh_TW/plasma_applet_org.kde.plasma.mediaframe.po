#: qml/ConfigBehavior.qml:33
#, kde-format
msgctxt "@label:group form label for spinboxes"
msgid "Change picture every:"
msgstr "圖片變更頻率："

# Change picture every:
#: qml/ConfigBehavior.qml:52
#, kde-format
msgctxt "@item:valuesuffix"
msgid "Hours"
msgstr "每小時"

#: qml/ConfigBehavior.qml:66
#, kde-format
msgctxt "@item:valuesuffix"
msgid "Minutes"
msgstr "每分鐘"

#: qml/ConfigBehavior.qml:80
#, kde-format
msgctxt "@item:valuesuffix"
msgid "Seconds"
msgstr "每秒鐘"

#: qml/ConfigBehavior.qml:88
#, kde-format
msgctxt "@option:check"
msgid "Randomize order"
msgstr "隨機順序"

#: qml/ConfigBehavior.qml:95
#, kde-format
msgctxt "@option:check"
msgid "Pause slideshow when hovered"
msgstr "游標停留時暫停幻燈片"

#: qml/ConfigBehavior.qml:101
#, kde-format
msgctxt "@label:listbox"
msgid "Image fill mode:"
msgstr "圖片填充模式："

#: qml/ConfigBehavior.qml:109
#, kde-format
msgctxt "@item:inlistbox"
msgid "Stretch"
msgstr "伸縮"

#: qml/ConfigBehavior.qml:110
#, kde-format
msgctxt "@info"
msgid "The image is scaled to fit the frame"
msgstr "影像大小依視框調整"

#: qml/ConfigBehavior.qml:114
#, kde-format
msgctxt "@item:inlistbox"
msgid "Preserve aspect fit"
msgstr "保留縱橫比，不裁切"

#: qml/ConfigBehavior.qml:115
#, kde-format
msgctxt "@info"
msgid "The image is scaled uniformly to fit without cropping"
msgstr "影像大小依視框調整，但是保持比例不裁切"

#: qml/ConfigBehavior.qml:119
#, kde-format
msgctxt "@item:inlistbox"
msgid "Preserve aspect crop"
msgstr "保留縱橫比，裁切"

#: qml/ConfigBehavior.qml:120
#, kde-format
msgctxt "@info"
msgid "The image is scaled uniformly to fill, cropping if necessary"
msgstr "影像大小依視框調整，超過就裁切"

#: qml/ConfigBehavior.qml:124
#, kde-format
msgctxt "@item:inlistbox"
msgid "Tile"
msgstr "鋪排"

#: qml/ConfigBehavior.qml:125
#, kde-format
msgctxt "@info"
msgid "The image is duplicated horizontally and vertically"
msgstr "圖片水平與垂直複製"

#: qml/ConfigBehavior.qml:129
#, kde-format
msgctxt "@item:inlistbox"
msgid "Tile vertically"
msgstr "垂直平鋪"

#: qml/ConfigBehavior.qml:130
#, kde-format
msgctxt "@info"
msgid "The image is stretched horizontally and tiled vertically"
msgstr "圖片水平伸展並垂直平鋪"

#: qml/ConfigBehavior.qml:134
#, kde-format
msgctxt "@item:inlistbox"
msgid "Tile horizontally"
msgstr "水平平鋪"

#: qml/ConfigBehavior.qml:135
#, kde-format
msgctxt "@info"
msgid "The image is stretched vertically and tiled horizontally"
msgstr "圖片垂直伸展並水平平鋪"

#: qml/ConfigBehavior.qml:139
#, kde-format
msgctxt "@item:inlistbox"
msgid "Pad"
msgstr "Pad"

#: qml/ConfigBehavior.qml:140
#, kde-format
msgctxt "@info"
msgid "The image is not transformed"
msgstr "圖片不變動"

