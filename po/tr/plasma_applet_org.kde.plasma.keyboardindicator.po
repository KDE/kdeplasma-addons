#: config.qml:13
#, kde-format
msgctxt "@title"
msgid "Keys"
msgstr "Düğmeler"

#: configAppearance.qml:37
#, kde-format
msgctxt ""
"@label show keyboard indicator when Caps Lock or Num Lock is activated"
msgid "Show when activated:"
msgstr "Etkinleştirildiğinde göster:"

#: configAppearance.qml:40
#, kde-format
msgctxt "@option:check"
msgid "Caps Lock"
msgstr "Büyük Harf"

#: configAppearance.qml:47
#, kde-format
msgctxt "@option:check"
msgid "Num Lock"
msgstr "Sayı Kilidi"

#: main.qml:115
#, kde-format
msgctxt "@info:tooltip widget subtitle, Alt applies to next press"
msgid "Alt is latched"
msgstr "Seçenek takılı"

#: main.qml:117
#, kde-format
msgctxt "@info:tooltip widget subtitle, Alt applies until pressed again"
msgid "Alt is locked"
msgstr "Seçenek kilitli"

#: main.qml:121
#, kde-format
msgctxt "@info:tooltip widget subtitle, Shift applies to next press"
msgid "Shift is latched"
msgstr "Üst Karakter takılı"

#: main.qml:123
#, kde-format
msgctxt "@info:tooltip widget subtitle, Shift applies until pressed again"
msgid "Shift is locked"
msgstr "Üst Karakter kilitli"

#: main.qml:127
#, kde-format
msgctxt "@info:tooltip widget subtitle, Ctrl applies to next press"
msgid "Control is latched"
msgstr "Kontrol takılı"

#: main.qml:129
#, kde-format
msgctxt "@info:tooltip widget subtitle, Ctrl applies until pressed again"
msgid "Control is locked"
msgstr "Kontrol kilitli"

#: main.qml:133
#, kde-format
msgctxt "@info:tooltip widget subtitle, Meta applies to next press"
msgid "Meta is latched"
msgstr "Meta takılı"

#: main.qml:135
#, kde-format
msgctxt "@info:tooltip widget subtitle, Meta applies until pressed again"
msgid "Meta is locked"
msgstr "Meta kilitli"

#: main.qml:139
#, kde-format
msgctxt "@info:tooltip widget subtitle, AltGr applies to next press"
msgid "Alt Gr is latched"
msgstr "Üst Seçenek takılı"

#: main.qml:141
#, kde-format
msgctxt "@info:tooltip widget subtitle, AltGr applies until pressed again"
msgid "Alt Gr is locked"
msgstr "Üst Seçenek kilitli"

#: main.qml:145
#, kde-format
msgctxt "@info:tooltip widget subtitle, Caps Lock on"
msgid "Caps Lock activated"
msgstr "Büyük Harf etkin"

#: main.qml:148
#, kde-format
msgctxt "@info:tooltip widget subtitle, Num Lock on"
msgid "Num Lock activated"
msgstr "Sayı Kilidi etkin"

#: main.qml:156
#, kde-format
msgctxt ""
"@info:tooltip widget subtitle, no Lock keys or sticky modifiers active"
msgid "No lock keys activated"
msgstr "Bir kilit düğmesi etkin değil"
