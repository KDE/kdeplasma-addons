#, kde-format
msgctxt "@info:tooltip widget subtitle, Alt applies to next press"
msgid "Alt is latched"
msgstr "مفتاح Alt مثبت"

#: main.qml:119
#, kde-format
msgctxt "@info:tooltip widget subtitle, Alt applies until pressed again"
msgid "Alt is locked"
msgstr "مفتاح Alt مقفل"

#: main.qml:123
#, kde-format
msgctxt "@info:tooltip widget subtitle, Shift applies to next press"
msgid "Shift is latched"
msgstr "مفتاح Shift مثبت"

