#: config.qml:13
#, kde-format
msgctxt "@title"
msgid "Keys"
msgstr "المفاتيح"

#: configAppearance.qml:37
#, kde-format
msgctxt ""
"@label show keyboard indicator when Caps Lock or Num Lock is activated"
msgid "Show when activated:"
msgstr "اعرض عن تنشيط:"

#: configAppearance.qml:40
#, kde-format
msgctxt "@option:check"
msgid "Caps Lock"
msgstr "قفل الحروف الكبيرة"

#: configAppearance.qml:47
#, kde-format
msgctxt "@option:check"
msgid "Num Lock"
msgstr "قفل الأرقام"

