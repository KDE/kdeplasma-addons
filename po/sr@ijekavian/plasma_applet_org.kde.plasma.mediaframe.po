#: qml/config.qml:13
#, kde-format
msgctxt "@title"
msgid "Media"
msgstr "Медији"

#: qml/config.qml:18
#, kde-format
msgctxt "@title"
msgid "Behavior"
msgstr "Понашање"

#: qml/ConfigBehavior.qml:48
#, kde-format
msgid "Change picture every:"
msgstr "Мијењај слику сваких:"

#: qml/ConfigBehavior.qml:65
#, kde-format
msgid "Hours"
msgstr "сати"

#: qml/ConfigBehavior.qml:79
#, kde-format
msgid "Minutes"
msgstr "минута"

#: qml/ConfigBehavior.qml:93
#, kde-format
msgid "Seconds"
msgstr "секунди"

#: qml/ConfigBehavior.qml:103
#, kde-format
msgctxt "@label:listbox"
msgid "Image fill mode:"
msgstr "Режим попуне слике:"

# >> @item:inlistbox Fill mode
#: qml/ConfigBehavior.qml:110
#, kde-format
msgctxt "@item:inlistbox"
msgid "Stretch"
msgstr "развучено"

# >> @text:tooltip
#: qml/ConfigBehavior.qml:111
#, kde-format
msgctxt "@info"
msgid "The image is scaled to fit the frame"
msgstr "Слика се скалира да стане у оквир."

# >> @item:inlistbox Fill mode
#: qml/ConfigBehavior.qml:115
#, kde-format
msgctxt "@item:inlistbox"
msgid "Preserve aspect fit"
msgstr "уклапање по размјери"

# >> @text:tooltip
#: qml/ConfigBehavior.qml:116
#, kde-format
msgctxt "@info"
msgid "The image is scaled uniformly to fit without cropping"
msgstr "Слика се скалира равномјерно да стане без опсијецања."

# >> @item:inlistbox Fill mode
#: qml/ConfigBehavior.qml:120
#, kde-format
msgctxt "@item:inlistbox"
msgid "Preserve aspect crop"
msgstr "опсијецање по размјери"

# >> @text:tooltip
#: qml/ConfigBehavior.qml:121
#, kde-format
msgctxt "@info"
msgid "The image is scaled uniformly to fill, cropping if necessary"
msgstr "Слика се скалира равномјерно да попуни све, ако треба уз опсијецање."

# >> @item:inlistbox Fill mode
#: qml/ConfigBehavior.qml:125
#, kde-format
msgctxt "@item:inlistbox"
msgid "Tile"
msgstr "поплочано"

# >> @text:tooltip
#: qml/ConfigBehavior.qml:126
#, kde-format
msgctxt "@info"
msgid "The image is duplicated horizontally and vertically"
msgstr "Слика се умножава водоравно и усправно."

# >> @item:inlistbox Fill mode
#: qml/ConfigBehavior.qml:130
#, kde-format
msgctxt "@item:inlistbox"
msgid "Tile vertically"
msgstr "поплочано усправно"

# >> @text:tooltip
#: qml/ConfigBehavior.qml:131
#, kde-format
msgctxt "@info"
msgid "The image is stretched horizontally and tiled vertically"
msgstr "Слика се развлачи водоравно а поплочава усправно."

# >> @item:inlistbox Fill mode
#: qml/ConfigBehavior.qml:135
#, kde-format
msgctxt "@item:inlistbox"
msgid "Tile horizontally"
msgstr "поплочано водоравно"

# >> @text:tooltip
#: qml/ConfigBehavior.qml:136
#, kde-format
msgctxt "@info"
msgid "The image is stretched vertically and tiled horizontally"
msgstr "Слика се развлачи усправно а поплочава водоравно."

# >> @item:inlistbox Fill mode
#: qml/ConfigBehavior.qml:140
#, kde-format
msgctxt "@item:inlistbox"
msgid "Pad"
msgstr "попуњене ивице"

# >> @text:tooltip
#: qml/ConfigBehavior.qml:141
#, kde-format
msgctxt "@info"
msgid "The image is not transformed"
msgstr "Слика се никако не мијења."

#: qml/ConfigBehavior.qml:186
#, kde-format
msgctxt "@label:checkbox"
msgid "General:"
msgstr "Опште:"

#: qml/ConfigBehavior.qml:187
#, kde-format
msgctxt "@option:check"
msgid "Randomize order"
msgstr "Насумичан редослијед"

# skip-rule: t-cursor
#: qml/ConfigBehavior.qml:192
#, kde-format
msgctxt "@option:check"
msgid "Pause slideshow when cursor is over image"
msgstr "Паузирај слајдшоу када је показивач над сликом"

#: qml/ConfigBehavior.qml:197
#, kde-format
msgctxt "@option:check"
msgid "Click on image to open in external application"
msgstr "Клик на слику отвара је у спољашњем програму"

#: qml/ConfigMedia.qml:27
#, kde-format
msgctxt "@action:button"
msgid "Add Folder…"
msgstr "Додај фасциклу…"

#: qml/ConfigMedia.qml:32
#, kde-format
msgctxt "@action:button"
msgid "Add Files…"
msgstr "Додај фајлове…"

#: qml/ConfigMedia.qml:90
#, kde-format
msgctxt "@action:button tooltip on icon-only button"
msgid "Remove path"
msgstr "Уклони путању"

#: qml/ConfigMedia.qml:100
#, kde-format
msgctxt "@info placeholdermessage if no paths set"
msgid "No media configured"
msgstr "Нема подешених медија"

#: qml/ConfigMedia.qml:101
#, kde-format
msgctxt "@info placeholdermessage explanation"
msgid "Add files or folders to display them in the widget."
msgstr "Додајте фајлове или фасцикле да бисте их приказали у виџету."

# >> @title:window
#: qml/ConfigMedia.qml:107
#, kde-format
msgctxt "@title:window"
msgid "Choose Files"
msgstr "Избор фајлова"

# >> @title:window
#: qml/ConfigMedia.qml:127
#, kde-format
msgctxt "@title:window"
msgid "Choose a Folder"
msgstr "Избор фасцикле"

#: qml/main.qml:366
#, kde-format
msgctxt "@info placeholdermessage if no media loaded"
msgid "No media selected"
msgstr "Нема изабраних медија"

#: qml/main.qml:370 qml/main.qml:380
#, kde-format
msgctxt "@action:button opens settings dialog"
msgid "Choose media…"
msgstr "Изабери медије…"
